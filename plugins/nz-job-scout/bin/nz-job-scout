#!/usr/bin/env node

import { runCli } from '../runtime/scout.mjs';
import { runInventoryBatchCli, runInventoryCli } from '../runtime/provider.mjs';

const command = process.argv[2];
if (command === 'inventory-batch' || command === 'inventory') {
  try { await (command === 'inventory-batch' ? runInventoryBatchCli : runInventoryCli)(process.argv.slice(3)); }
  catch (error) { console.error(error instanceof Error ? error.message : String(error)); process.exitCode = 1; }
} else await runCli();
