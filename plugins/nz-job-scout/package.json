{
  "name": "@graham-gc/nz-job-scout",
  "version": "0.4.0",
  "private": true,
  "description": "Core utilities and zero-dependency runtime for the nz-job-scout Claude Code plugin.",
  "type": "module",
  "bin": {
    "nz-job-scout": "bin/nz-job-scout"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/sync-runtime.mjs",
    "build:check": "tsc -p tsconfig.json && node scripts/check-runtime.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run test:runtime",
    "test:runtime": "node --test tests/runtime.test.mjs"
  },
  "devDependencies": {
    "@types/node": ">=22 <26",
    "typescript": ">=5.7 <7"
  }
}
